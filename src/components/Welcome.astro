---
import astroLogo from "../assets/astro.svg";
import background from "../assets/background.svg";
import "../assets/index.css";
---

<div class="container">
  <div id="terminalexe">
    <div class="termino-console"></div>
    <textarea class="termino-input" rows="1" wrap="hard"></textarea>
  </div>
  <script
    src="https://rawcdn.githack.com/nextapps-de/winbox/0.2.82/dist/winbox.bundle.min.js"
  ></script>
  <script>
    import { Termino } from "../assets/termino.min.js";
    //@ts-ignore
    const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));
    let term = Termino(document.getElementById("terminalexe"));
    const start = async () => {
      term.output("Hello!");
      await sleep(1000);
      term.output("Welcome to the terminal!");
      await sleep(1000);
      let res1 = await term.input(
        "Type 'help' to see a list of commands. Do it now.",
      );
      if (res1.trim() === "help") {
        term.output("Here are the available commands:");
        term.output("1. help - Displays this help message.");
        term.output("2. projects - Lists my projects I've worked on.");
        term.output("3. about - Displays information about me.");
        term.output("4. ai - my thoughts on ai.");
        term.output("5. exit - Exits the terminal.");
      } else {
        term.output(
          "You didn't type 'help'. You had one instruction. You failed. Goodbye.",
        );
        await sleep(1500);
        term.kill();
      }
    };
    const run = async () => {
      await start();
      await sleep(1000);
      term.output("You may now type a command. Type the word of the command you want to run. Go.");
      let res2 = await term.input("");
      if (res2.trim() === "projects") {
        term.output("Here are some of the projects I've worked on:");
        term.output("1. This site - Fairly self explanatory I would hope. It's also on github (@th3-pr0gr4mm3r/ma-site) if you wanna take a little peek at the raw source code.");
        term.output("2. Project B - Description of Project B.");
        term.output("3. Project C - Description of Project C.");
        term.output("To be clear, this is a placeholder. I haven't actually made any projects yet. I'm a student, not a professional.");
        run();
      } else if (res2.trim() === "about") {
        term.output(
          "Sup! I'm Thomas, a student software developer with (some) experience in web development. Occasionally, stuff I write actually works. Usually, it kinda works and sometimes it just doesn't work at all ¯\\_(ツ)_/¯.",
        );
        run();
      } else if (res2.trim() === "help") {
        term.output("Here are the available commands:");
        term.output("1. help - Displays this help message.");
        term.output("2. projects - Lists my projects I've worked on.");
        term.output("3. about - Displays information about me.");
        term.output("4. exit - Exits the terminal.");
        run();
      } else if (res2.trim() === "exit") {
        term.output("Exiting the terminal. o7");
        term.kill();
      } else if (res2.trim() === "ai") {
        term.output("My thoughts on AI:");
        term.output("AI is a poorly defined buzzword and has too many meanings to be summed up into one field. So let's explore each different thing it can mean.");
        sleep(500);
        term.output("1. AI as in Machine Learning. Machine Learning is cool. Neural networks are cool. I think that in literal usecases they make lots of sense, like in the medical field or for looking at images for stuff like face recognition, and ANPR systems. It's really helpful.");
        sleep(500);
        term.output("2. AI as in LLMs. Less so. It's useful in some cases, I love using Copilot in my VSCode editor as an autocomplete. But I think that LLMs are overhyped and overused. I think that they are a tool, not a replacement for human intelligence. They are not sentient, they are not conscious, they are not alive. They are just a tool.");
        sleep(500);
        term.output("LLMs are also overtrusted. They hallucinate. A lot. They make stuff up for no reason and just generally suck at most things, unless very strongly grounded. I have had my copilot autocomplete make up functions that don't exist in anything. It sucks.")
        sleep(500);
        term.output("I am however now recently looking into adding some programming AI into my workflow. Whenever I can't figure something out, I will set AI on it using some programming tool and then read through the output and optimise/fix it myself. I think this is a good workflow for keeping AI being useful but safe.");
        run();
      } else {
        term.output(
          "Unknown command. Either you can't read or you tyop'd it. Either way, I'm not a magician or a LLM. Please type 'help' to see the list of available commands.",
        );
        run();
      }
    };
    run();
  </script>
</div>
