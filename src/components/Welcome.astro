---
import astroLogo from "../assets/astro.svg";
import background from "../assets/background.svg";
import "../assets/index.css";
---

<div class="container">
  <div id="terminalexe">
    <div class="termino-console"></div>
    <textarea class="termino-input" rows="1" wrap="hard"></textarea>
  </div>
  <script
    src="https://rawcdn.githack.com/nextapps-de/winbox/0.2.82/dist/winbox.bundle.min.js"
  ></script>
  <script>
    import { Termino } from "../assets/termino.min.js";
    //@ts-ignore
    const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));
    let term = Termino(document.getElementById("terminalexe"));
    const start = async () => {
      term.output("Hello!");
      await sleep(1000);
      term.output("Welcome to the terminal!");
      await sleep(1000);
      let res1 = await term.input(
        "Type 'help' to see a list of commands. Do it now.",
      );
      if (res1.trim() === "help") {
        term.output("Here are the available commands:");
        term.output("1. help - Displays this help message.");
        term.output("2. projects - Lists my projects I've worked on.");
        term.output("3. about - Displays information about me.");
      } else {
        term.output(
          "You didn't type 'help'. You had one instruction. You failed. Goodbye.",
        );
        await sleep(1500);
        term.kill();
      }
    };
    const run = async () => {
      await start();
      await sleep(1000);
      term.output("You may now type a command. Type the word of the command you want to run. Go.");
      let res2 = await term.input("");
      if (res2.trim() === "projects") {
        term.output("Here are some of the projects I've worked on:");
        term.output("1. Project A - Description of Project A.");
        term.output("2. Project B - Description of Project B.");
        term.output("3. Project C - Description of Project C.");
      } else if (res2.trim() === "about") {
        term.output(
          "Sup! I'm Thomas, a student software developer with (some) experience in web development. Occasionally, stuff I write actually works. Usually, it kinda works and sometimes it just doesn't work at all ¯\\_(ツ)_/¯.",
        );
      } else {
        term.output(
          "Unknown command. Please type 'help' to see the list of available commands.",
        );
        run();
      }
    };
    run();
  </script>
</div>
